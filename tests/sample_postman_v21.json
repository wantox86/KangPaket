{
  "info": {
    "name": "KangPaket Test Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "https://api.example.com"}
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "collection-level-token"}]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "https://api.example.com/auth/login",
              "query": []
            },
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Custom", "value": "{{customHeader}}", "disabled": false}
            ],
            "auth": {"type": "noauth"},
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin\", \"password\": \"secret\"}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": {"raw": "https://api.example.com/auth/refresh", "query": []},
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "refresh-token-here"}]
            },
            "body": {"mode": "none"}
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://api.example.com/users?page=1&limit=20",
              "query": [
                {"key": "page",  "value": "1"},
                {"key": "limit", "value": "20"},
                {"key": "inactive", "value": "true", "disabled": true}
              ]
            },
            "header": [
              {"key": "Accept", "value": "application/json"}
            ],
            "auth": {"type": "noauth"}
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": {"raw": "{{baseUrl}}/users", "query": []},
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                {"key": "username", "value": "admin"},
                {"key": "password", "value": "secret"}
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "name",   "value": "John Doe"},
                {"key": "email",  "value": "john@example.com"},
                {"key": "avatar", "type": "file", "src": "/path/to/file.png"}
              ]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "url": {"raw": "https://api.example.com/users/123", "query": []},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "name",  "value": "Jane Doe"},
                {"key": "role",  "value": "admin"},
                {"key": "extra", "value": "ignored", "disabled": true}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Misc",
      "item": [
        {
          "name": "GraphQL Query",
          "request": {
            "method": "POST",
            "url": {"raw": "https://api.example.com/graphql", "query": []},
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query { users { id name } }",
                "variables": {"limit": 10}
              }
            }
          }
        },
        {
          "name": "API Key Auth",
          "request": {
            "method": "GET",
            "url": {"raw": "https://api.example.com/data", "query": []},
            "header": [],
            "auth": {
              "type": "apikey",
              "apikey": [
                {"key": "key",   "value": "X-API-Key"},
                {"key": "value", "value": "my-secret-key"},
                {"key": "in",    "value": "header"}
              ]
            }
          }
        },
        {
          "name": "File Upload",
          "request": {
            "method": "POST",
            "url": {"raw": "https://api.example.com/upload", "query": []},
            "header": [],
            "body": {"mode": "file", "file": {"src": "/path/to/file"}}
          }
        },
        {
          "name": "Disabled Headers",
          "request": {
            "method": "GET",
            "url": {"raw": "https://api.example.com/test", "query": []},
            "header": [
              {"key": "X-Active",   "value": "yes"},
              {"key": "X-Disabled", "value": "no", "disabled": true}
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {"listen": "prerequest", "script": {"exec": ["console.log('hello')"]}}
  ]
}
